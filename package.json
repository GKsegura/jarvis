{
  "name": "jarvis-hud",
  "version": "0.8.0",
  "description": "Assistente pessoal estilo JARVIS no navegador: núcleo de voz, painéis com dados reais, gestos com a webcam, reconhecimento facial e Claude.",
  "license": "MIT",
  "author": "José Antônio Segura Marques da Silva",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GKsegura/jarvis.git"
  },
  "homepage": "https://github.com/GKsegura/jarvis#readme",
  "bugs": {
    "url": "https://github.com/GKsegura/jarvis/issues"
  },
  "keywords": [
    "jarvis",
    "voice-assistant",
    "hud",
    "mediapipe",
    "face-api",
    "vite",
    "typescript"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "jarvis": "node scripts/jarvis.mjs",
