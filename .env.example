# Copie para .env e preencha. O .env nunca vai para o git.

# Chave da API do fish.audio (https://fish.audio → API Keys). Junto com o FISH_AUDIO_VOICE_ID, liga a voz do fish.audio.
FISH_AUDIO_API_KEY=

# ID da voz no fish.audio (o código na URL da página da voz). Sem ele, o JARVIS usa a voz do navegador.
# Passo a passo no README, seção "Colocar a voz do Jarvis".
FISH_AUDIO_VOICE_ID=

# Motor do fish.audio. "s2.1-pro-free" funciona sem crédito de API; os outros (s1, s2-pro, s2.1-pro) podem exigir crédito.
FISH_AUDIO_MODEL=s2.1-pro-free

# Opcional: modelo do Claude usado pelo JARVIS (haiku, sonnet, opus). Padrão: haiku
JARVIS_CLAUDE_MODEL=

# Spotify (Premium): crie um app grátis em https://developer.spotify.com/dashboard com o Redirect URI
# http://127.0.0.1:5173/api/spotify/callback e cole o Client ID aqui (não precisa do Client Secret).
SPOTIFY_CLIENT_ID=

# Opcional: API do janus (padrão: a versão Docker com os dados reais, http://127.0.0.1:8082/api)
JANUS_API_URL=

# Opcional: país das buscas no Spotify (padrão BR)
SPOTIFY_MARKET=
